{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DbSettings": {
    "ConnectionString": "mongodb://admin:password@invoicing-db-mongo:27017/?authSource=admin",
    "DatabaseName": "vankoo_invoicing_db_dev"
  },
  "KafkaSettings": {
    "BootstrapServers": "kafka-broker:9094",
    "ClientId": "vankoo-invoicing-producer",
    "MessageTimeoutMs": 5000,
    "Acks": "All",
    "EnableIdempotence": true,
    "Retries": 3
  },
  "MinioSettings": {
    "Endpoint": "minio:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "invoices",
    "AutoCreateBucket": true,
    "UseSSL": false
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://discovery-server:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": false,
      "ValidateCertificates": false
    },
    "Instance": {
      "AppName": "invoicing-service",
      "HostName": "invoicing-service",
      "Port": 8080,
      "SecurePortEnabled": false,
      "HealthCheckUrlPath": "/health/ready",
      "StatusPageUrlPath": "/health/live"
    }
  }
}
